#!/bin/sh
# Build the checkout with its own build tool and copy the runnable jar to the given path.
#
# Maven projects build with the Maven wrapper when the checkout has one, or else with the
# image's Maven; Gradle projects build with their Gradle wrapper. Tests are not built or run.
# JAVA_BUILD_COMMAND replaces the build command, and JAVA_BUILD_JAR names the jar to copy,
# relative to the checkout, when the build produces more than one.
set -eu
output="${1:?Usage: java-build <output jar>}"
cd "${APP_ROOT:-/usr/src/app}"
# Build tools report on stderr, so that standard output stays the application's.
exec 1>&2

if [ -n "${JAVA_BUILD_COMMAND:-}" ]; then
  sh -ec "$JAVA_BUILD_COMMAND"
  outputs=.
elif [ -f pom.xml ]; then
  if [ -f mvnw ]; then mvn="sh ./mvnw"; else mvn=mvn; fi
  # The compiler plugin records a compilation that failed as done. Built again
  # without a newer source, as a watched workspace may do, it would find
  # "nothing to compile" and package the last good classes as a success.
  # Dropping its state after a failure makes the next build compile again.
  # shellcheck disable=SC2086
  if ! $mvn -B -ntp -Dmaven.test.skip=true ${JAVA_BUILD_ARGS:-} package; then
    rm -rf target/maven-status
    exit 1
  fi
  outputs=target
elif [ -f build.gradle ] || [ -f build.gradle.kts ]; then
  [ -f gradlew ] || { echo 'java-build: Gradle projects need the Gradle wrapper (gradlew)' >&2; exit 1; }
  # A one-off build stops its daemon and builds what assemble builds.
  gradle="--no-daemon" task=assemble
  if [ -n "${JAVA_GRADLE_WORKSPACE:-}" ]; then
    # Workspace rebuilds (workspace-java) keep the daemon, compile Kotlin inside it
    # instead of in a Kotlin daemon of its own, and with the init script build only
    # the runnable jar, uncompressed. A jar named by JAVA_BUILD_JAR may come from any
    # task, so that build still runs assemble.
    gradle="--daemon --init-script /usr/local/share/wodby/workspace.init.gradle -Pkotlin.compiler.execution.strategy=in-process"
    [ -n "${JAVA_BUILD_JAR:-}" ] || task=wodbyWorkspaceJar
  fi
  # shellcheck disable=SC2086
  sh ./gradlew $gradle -q ${JAVA_BUILD_ARGS:-} "$task"
  outputs=build/libs
else
  echo 'java-build: no pom.xml, build.gradle or build.gradle.kts in the checkout' >&2
  exit 1
fi

if [ -n "${JAVA_BUILD_JAR:-}" ]; then
  jar="$JAVA_BUILD_JAR"
  [ -f "$jar" ] || { echo "java-build: $jar was not built" >&2; exit 1; }
else
  # Leave out the archives that build tools make next to the runnable one.
  jars=$(find "$outputs" -maxdepth 1 -type f -name '*.jar' \
    ! -name '*-sources.jar' ! -name '*-javadoc.jar' ! -name '*-tests.jar' \
    ! -name '*-plain.jar' ! -name 'original-*.jar' 2>/dev/null | sort)
  count=$(printf '%s' "$jars" | grep -c . || true)
  if [ "$count" -ne 1 ]; then
    echo "java-build: expected one jar in $outputs, found $count; set JAVA_BUILD_JAR" >&2
    [ -z "$jars" ] || printf '%s\n' "$jars" >&2
    exit 1
  fi
  jar="$jars"
fi

# Replace the output in one step, so a running application never reads a partial file.
mkdir -p "$(dirname "$output")"
tmp=$(mktemp "$output.XXXXXX")
cp "$jar" "$tmp"
mv "$tmp" "$output"
